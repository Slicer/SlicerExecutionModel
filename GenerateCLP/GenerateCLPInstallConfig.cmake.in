# GenerateCLP could be installed anywhere, so set all paths based on where
# this file was found.
get_filename_component(GenerateCLP_CONFIG_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_gclp_prefix
  "${GenerateCLP_CONFIG_DIR}/@GenerateCLP_CONFIG_TO_PREFIX@" ABSOLUTE
  )

set(GenerateCLP_INCLUDE_DIRS "")
set(GenerateCLP_LIBRARY_DIRS "${_gclp_prefix}/@ModuleDescriptionParser_INSTALL_LIB_DIR_CONFIG@")
set(GenerateCLP_CMAKE_DIR "${GenerateCLP_CONFIG_DIR}")
set(GenerateCLP_USE_FILE "${GenerateCLP_CONFIG_DIR}/UseGenerateCLP.cmake")
set(GenerateCLP_USE_JSONCPP "@GenerateCLP_USE_JSONCPP@")
set(GenerateCLP_USE_SERIALIZER "@GenerateCLP_USE_SERIALIZER@")
set(GENERATECLP_EXE "${_gclp_prefix}/@GenerateCLP_INSTALL_BIN_DIR@/GenerateCLP@CMAKE_EXECUTABLE_SUFFIX@")

if(NOT DEFINED SlicerExecutionModel_USE_UTF8)
  set(SlicerExecutionModel_USE_UTF8 "@SlicerExecutionModel_USE_UTF8@")
endif()
if(NOT DEFINED SlicerExecutionModel_CMAKE_DIR)
  set(SlicerExecutionModel_CMAKE_DIR "${_gclp_prefix}/@SlicerExecutionModel_INSTALL_CONFIG_DIR@/CMake")
endif()
set(TCLAP_DIR "${_gclp_prefix}/lib/tclap")
set(ModuleDescriptionParser_DIR "${_gclp_prefix}/lib/ModuleDescriptionParser")
if(NOT DEFINED ITK_DIR)
  set(ITK_DIR "@ITK_DIR@")
endif()

set(GenerateCLP_JsonCpp_INCLUDE_DIR "@JsonCpp_INCLUDE_DIR@")
if(NOT "${GenerateCLP_JsonCpp_INCLUDE_DIR}" STREQUAL "")
  set(JsonCpp_INCLUDE_DIR ${GenerateCLP_JsonCpp_INCLUDE_DIR})
endif()

set(GenerateCLP_JsonCpp_LIBRARY "@JsonCpp_LIBRARY@")
if(NOT "${GenerateCLP_JsonCpp_LIBRARY}" STREQUAL "")
  set(JsonCpp_LIBRARY ${GenerateCLP_JsonCpp_LIBRARY})
endif()

set(GenerateCLP_ParameterSerializer_DIR "@ParameterSerializer_DIR@")
if(NOT "${GenerateCLP_ParameterSerializer_DIR}" STREQUAL "")
  set(ParameterSerializer_DIR ${GenerateCLP_ParameterSerializer_DIR})
endif()

include("${SlicerExecutionModel_CMAKE_DIR}/SEMFunctionAddExecutable.cmake")
unset(_gclp_prefix)
